{
  // TypeScript compiler configuration for the Cloudflare Worker / Durable Object server code.
  "compilerOptions": {
    // Target ES2022 supported by the Cloudflare Workers V8 isolate runtime.
    "target": "ES2022",
    // Resolve modules as ESNext for Wrangler bundling.
    "module": "ESNext",
    // Use Bundler module resolution for workspace imports and Drizzle modules.
    "moduleResolution": "Bundler",
    // Enforce strict null and type checking across server code.
    "strict": true,
    // Typecheck only via tsc; Wrangler handles bundling.
    "noEmit": true,
    // Skip typechecking external declaration files.
    "skipLibCheck": true,
    // Include Cloudflare Workers ambient runtime types (D1Database, DurableObjectNamespace, etc.).
    "types": ["@cloudflare/workers-types"]
  },
  // Include server source files and shared cross-workspace types/physics; exclude Bun unit tests.
  "include": ["./src/**/*.ts", "../../shared/**/*.ts"],
  "exclude": ["./src/__tests__/**/*.ts"]
}
